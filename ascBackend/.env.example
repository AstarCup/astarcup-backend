# 数据库
DATABASE_URL=postgresql://user:password@localhost:5432/asc

# 服务
PORT=4000
# 允许的跨域来源，逗号分隔
CORS_ORIGINS=http://localhost:5173
# 登录成功后的重定向地址
FRONTEND_URL=http://localhost:5173

# 统一认证（JWT HttpOnly Cookie）
JWT_SECRET=change-me-to-a-long-random-string
# 会话有效期（天）
JWT_EXPIRE_DAYS=30

# osu! OAuth2
OSU_CLIENT_ID=client_id
OSU_CLIENT_SECRET=client_secret
OSU_REDIRECT_URI=http://localhost:4000/api/auth/callback

# 本地文件存储（.osz / 回放 .osr），替代 Vercel Blob
STORAGE_DIR=./storage

# 敏感词库目录
VOCAB_DIR=./vocabulary

# AstrBot 专用接口（X-Bot-Token 鉴权；留空则关闭 /api/bot/*）
# 注意：bot token 只认证机器人；选手身份由网站绑定流程（一键链接/绑定码）确定
BOT_TOKEN=
# 比赛规则 Markdown 目录，按赛季命名：{season}.md（如 s1.md）
BOT_RULES_DIR=./rules

# g0v0 私服 OAuth 绑定
G0V0_ENABLED=false
G0V0_CLIENT_ID=
G0V0_CLIENT_SECRET=
G0V0_REDIRECT_URI=http://localhost:4000/api/bind/callback
G0V0_OAUTH_BASE=https://lazer-api.g0v0.top
