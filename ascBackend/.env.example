# 数据库
DATABASE_URL=postgresql://user:password@localhost:5432/asc

# 服务
PORT=4000
# 允许的跨域来源，逗号分隔
CORS_ORIGINS=http://localhost:3000
# 登录成功后的重定向地址
FRONTEND_URL=http://localhost:3000

# 统一认证（JWT HttpOnly Cookie）
JWT_SECRET=change-me-to-a-long-random-string
# 会话有效期（天）
JWT_EXPIRE_DAYS=30

# osu! OAuth2
OSU_CLIENT_ID=client_id
OSU_CLIENT_SECRET=client_secret
OSU_REDIRECT_URI=http://localhost:4000/api/auth/callback

# 本地文件存储（.osz / 回放 .osr），替代 Vercel Blob
STORAGE_DIR=./storage

# 敏感词库目录
VOCAB_DIR=/home/aecw/astarcup/astracup-web/src/app/api/content-detect/Vocabulary
